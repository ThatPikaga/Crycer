#!/usr/bin/env bash
# Crycer launcher for Arch Linux (and Arch-based setups such as Omarchy, EndeavourOS, Manjaro).
#
#   ./crycer                 open the Crycer web app (builds it the first time)
#   ./crycer web             same as above
#   ./crycer classic <iso>   one-time setup of the original 1997 Bryce 3D from YOUR OWN Bryce3DCD.iso
#   ./crycer classic         start the original Bryce 3D natively with Wine (no Docker, no VNC)
#   ./crycer install         put `crycer` on your PATH and add app-menu entries
#   ./crycer uninstall       remove the PATH link and app-menu entries (keeps your projects)
#   ./crycer doctor          show what is installed and what is missing
#
# Nothing from Bryce 3D is shipped with Crycer. Classic mode only unpacks a CD image you provide.
set -euo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/crycer"
CLASSIC_DIR="$DATA_DIR/classic"
BRYCE_DIR="$CLASSIC_DIR/bryce3d"
CD_DIR="$CLASSIC_DIR/cd"
TOOLS_DIR="$DATA_DIR/tools"
export WINEPREFIX="${CRYCER_WINEPREFIX:-$CLASSIC_DIR/wine}"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree=;mshtml=;winemenubuilder.exe=d}"
PROJECTS_DIR="${CRYCER_PROJECTS:-$HOME/Crycer/Projects}"
PORT="${CRYCER_PORT:-5192}"
BIN_DIR="$HOME/.local/bin"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

say()  { printf '\033[1;36m[crycer]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[crycer]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[crycer]\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Install Arch packages that are missing, asking sudo only when something is actually needed.
need_pkgs() {
  local missing=()
  for p in "$@"; do pacman -Qq "$p" >/dev/null 2>&1 || missing+=("$p"); done
  [ ${#missing[@]} -eq 0 ] && return 0
  have pacman || die "pacman not found. Install these yourself: ${missing[*]}"
  say "Installing: ${missing[*]} (sudo will ask for your password)"
  sudo pacman -S --needed --noconfirm "${missing[@]}"
}

open_url() {
  if have xdg-open; then xdg-open "$1" >/dev/null 2>&1 &
  else say "Open $1 in your browser."; fi
}

# ------------------------------------------------------------------------------------------
# Web app
# ------------------------------------------------------------------------------------------
web() {
  cd "$APP_DIR"
  [ -f package.json ] || die "Run this from the Crycer folder (package.json not found)."
  have node && have npm || need_pkgs nodejs npm
  local major; major="$(node -p 'process.versions.node.split(".")[0]')"
  [ "$major" -ge 22 ] || die "Crycer needs Node 22 or newer (found $(node -v)). Run: sudo pacman -Syu nodejs"

  if [ ! -d node_modules ] || [ package-lock.json -nt node_modules ]; then
    say "Installing the web app's packages (first run only)..."
    npm ci --no-audit --no-fund
    touch node_modules
  fi
  # Rebuild when any source file is newer than the last build.
  if [ ! -f dist/index.html ] || [ -n "$(find src public index.html embed.html gallery.html vite.config.ts -newer dist/index.html -print -quit 2>/dev/null)" ]; then
    say "Building Crycer..."
    npm run build
  fi
  local url="http://127.0.0.1:$PORT/"
  say "Crycer is running at $url  (Ctrl+C to stop)"
  ( sleep 1.5; open_url "$url" ) &
  exec npx vite preview --host 127.0.0.1 --port "$PORT" --strictPort
}

# ------------------------------------------------------------------------------------------
# Classic: the original Bryce 3D (1997) through Wine, straight on your desktop
# ------------------------------------------------------------------------------------------
build_unshieldv3() {
  have unshieldv3 && { UNSHIELD="$(command -v unshieldv3)"; return; }
  UNSHIELD="$TOOLS_DIR/bin/unshieldv3"
  [ -x "$UNSHIELD" ] && return
  need_pkgs git cmake base-devel
  say "Building unshieldv3 (unpacks the InstallShield 3 archive without the 16-bit installer)..."
  local src; src="$(mktemp -d)"
  git clone --depth 1 https://github.com/wfr/unshieldv3.git "$src/unshieldv3"
  cmake -S "$src/unshieldv3" -B "$src/build" -DCMAKE_INSTALL_PREFIX="$TOOLS_DIR" -DCMAKE_BUILD_TYPE=Release >/dev/null
  cmake --build "$src/build" -j"$(nproc)" >/dev/null
  cmake --install "$src/build" >/dev/null
  rm -rf "$src"
  [ -x "$UNSHIELD" ] || die "unshieldv3 did not build."
}

extract_iso() {
  local iso="$1"
  [ -f "$iso" ] || die "No such file: $iso"
  build_unshieldv3
  say "Unpacking Bryce 3D from $(basename "$iso")..."
  local tmp; tmp="$(mktemp -d)"
  bsdtar -xf "$iso" -C "$tmp" data.1 2>/dev/null || die "This ISO has no data.1. Is it the Bryce 3D (1997) CD?"
  mkdir -p "$tmp/unpacked"
  "$UNSHIELD" extract "$tmp/data.1" "$tmp/unpacked" >/dev/null
  local prog; prog="$(find "$tmp/unpacked" -maxdepth 2 -type d -iname prog | head -n1)"
  [ -n "$prog" ] || die "Could not find the program folder inside data.1."
  rm -rf "$BRYCE_DIR"; mkdir -p "$BRYCE_DIR" "$CD_DIR"
  cp -a "$prog"/. "$BRYCE_DIR/"
  chmod -R u+rwX "$BRYCE_DIR"

  say "Copying the CD's libraries, sample scenes and manual..."
  bsdtar -xf "$iso" -C "$CD_DIR" \
    --exclude='data.1' --exclude='Adobe Acrobat Reader 3*' --exclude='DirectX5*' --exclude='OpenGL*' \
    --exclude='QuickTime Installer.EXE' --exclude='SETUP.EXE' --exclude='SETUP.INS' --exclude='_INST32I.EX_' \
    --exclude='_ISDEL.EXE' --exclude='_SETUP.DLL' --exclude='_SETUP.LIB' --exclude='setup.*' 2>/dev/null || true
  chmod -R u+rwX "$CD_DIR" 2>/dev/null || true
  rm -rf "$tmp"
  [ -f "$BRYCE_DIR/Bryce 3D.exe" ] || die "Unpacked, but 'Bryce 3D.exe' is missing."
}

init_prefix() {
  say "Creating a Wine prefix at $WINEPREFIX ..."
  mkdir -p "$(dirname "$WINEPREFIX")"
  # Classic 32-bit prefix where the installed Wine supports it; Arch's current WoW64 Wine runs
  # 32-bit programs from a normal prefix, so fall back to that.
  if ! WINEARCH=win32 wineboot --init >/dev/null 2>&1; then
    rm -rf "$WINEPREFIX"
    wineboot --init >/dev/null 2>&1 || die "wineboot failed. Try: wineboot --init (with WINEPREFIX=$WINEPREFIX) to see why."
  fi
  wineserver -w

  local ver="winxp"; grep -q '^#arch=win32' "$WINEPREFIX/system.reg" 2>/dev/null && ver="win98"
  local reg; reg="$(mktemp --suffix=.reg)"
  cat > "$reg" <<EOF
Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\\Software\\Wine]
"Version"="$ver"

[HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives]
"d:"="cdrom"
"e:"="hd"

[HKEY_CLASSES_ROOT\\.br3]
@="Bryce3Dfile"

[HKEY_CLASSES_ROOT\\Bryce3Dfile\\Shell\\open\\command]
@="\\"C:\\\\Bryce3D\\\\Bryce 3D.exe\\" \\"%1\\""
EOF
  wine regedit "$reg" >/dev/null 2>&1
  wineserver -w
  rm -f "$reg"
}

link_folders() {
  mkdir -p "$PROJECTS_DIR" "$WINEPREFIX/dosdevices" "$WINEPREFIX/drive_c"
  ln -sfn "$BRYCE_DIR" "$WINEPREFIX/drive_c/Bryce3D"
  ln -sfn "$CD_DIR" "$WINEPREFIX/dosdevices/d:"
  ln -sfn "$PROJECTS_DIR" "$WINEPREFIX/dosdevices/e:"
  ln -sfn "$PROJECTS_DIR" "$BRYCE_DIR/Projects"
  ln -sfn "$CD_DIR" "$BRYCE_DIR/CD_Content"
}

classic_setup() {
  [ "$(uname -m)" = "x86_64" ] || die "Classic mode needs an x86_64 PC (Bryce 3D is a 32-bit Windows program). The web app works everywhere: ./crycer web"
  need_pkgs wine libarchive
  # 32-bit graphics libraries help on Wine builds that still use them; skip quietly when multilib is off.
  if pacman -Si lib32-mesa >/dev/null 2>&1; then need_pkgs lib32-mesa || true
  else warn "multilib is not enabled; continuing without lib32-mesa (fine with Arch's WoW64 Wine)."; fi

  extract_iso "$1"
  rm -rf "$WINEPREFIX"
  init_prefix
  link_folders
  touch "$CLASSIC_DIR/.ready"
  say "Classic Bryce 3D is set up. Start it with: crycer classic"
  say "Bryce asks for your name and serial once on first launch."
  say "Saving to E:\\ or Bryce3D\\Projects puts files in $PROJECTS_DIR"
}

classic_run() {
  [ -f "$CLASSIC_DIR/.ready" ] || die "Classic mode is not set up yet. Run: crycer classic /path/to/Bryce3DCD.iso"
  have wine || die "Wine is missing. Run: sudo pacman -S wine"
  link_folders
  say "Starting Bryce 3D (1997). Files you save to E:\\ land in $PROJECTS_DIR"
  cd "$BRYCE_DIR"
  exec wine "C:\\Bryce3D\\Bryce 3D.exe" "$@"
}

# ------------------------------------------------------------------------------------------
# Install / uninstall / doctor
# ------------------------------------------------------------------------------------------
install_launcher() {
  mkdir -p "$BIN_DIR" "$DESKTOP_DIR"
  ln -sfn "$APP_DIR/crycer" "$BIN_DIR/crycer"
  local icon="$APP_DIR/public/icon-512.png"; [ -f "$icon" ] || icon="$APP_DIR/public/icon-192.png"
  cat > "$DESKTOP_DIR/crycer.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Crycer
Comment=Make surreal ray-traced Bryce-style worlds in your browser
Exec=$BIN_DIR/crycer web
Icon=$icon
Terminal=true
Categories=Graphics;3DGraphics;
EOF
  cat > "$DESKTOP_DIR/crycer-classic.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Crycer Classic (Bryce 3D 1997)
Comment=The original Bryce 3D through Wine, from your own CD image
Exec=$BIN_DIR/crycer classic
Icon=$icon
Terminal=false
Categories=Graphics;3DGraphics;
EOF
  have update-desktop-database && update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
  say "Installed. You can now run 'crycer' from anywhere, or find Crycer in your app launcher."
  case ":$PATH:" in *":$BIN_DIR:"*) ;; *) warn "$BIN_DIR is not on your PATH. Add it to your shell profile.";; esac
}

uninstall_launcher() {
  rm -f "$BIN_DIR/crycer" "$DESKTOP_DIR/crycer.desktop" "$DESKTOP_DIR/crycer-classic.desktop"
  say "Removed the launcher and menu entries."
  say "Classic data (Wine prefix, unpacked CD) is still in $DATA_DIR; delete it by hand if you want."
  say "Your projects in $PROJECTS_DIR were not touched."
}

doctor() {
  printf 'Crycer folder : %s\n' "$APP_DIR"
  printf 'Node          : %s\n' "$(node -v 2>/dev/null || echo missing)"
  printf 'Web build     : %s\n' "$([ -f "$APP_DIR/dist/index.html" ] && echo built || echo 'not built yet')"
  printf 'Wine          : %s\n' "$(wine --version 2>/dev/null || echo missing)"
  printf 'bsdtar        : %s\n' "$(have bsdtar && echo ok || echo missing)"
  printf 'Classic Bryce : %s\n' "$([ -f "$CLASSIC_DIR/.ready" ] && echo "ready ($BRYCE_DIR)" || echo 'not set up')"
  printf 'Projects      : %s\n' "$PROJECTS_DIR"
}

usage() { sed -n '2,12p' "$APP_DIR/crycer" | sed 's/^# \{0,1\}//'; }

case "${1:-web}" in
  web)        web ;;
  classic)    shift; if [ $# -ge 1 ] && [ -f "$1" ]; then classic_setup "$1"; else classic_run "$@"; fi ;;
  install)    install_launcher ;;
  uninstall)  uninstall_launcher ;;
  doctor)     doctor ;;
  -h|--help|help) usage ;;
  *)          usage; exit 1 ;;
esac
